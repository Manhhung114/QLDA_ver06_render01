# Google Drive Apps Script Gateway
QLDA_DRIVE_WEBAPP_URL=https://script.google.com/macros/s/AKfycb.../exec
QLDA_DRIVE_API_TOKEN=YOUR_LONG_RANDOM_TOKEN
QLDA_DRIVE_ENFORCE_RBAC=true
QLDA_DRIVE_DIRECT_MAX_UPLOAD_MB=2048
QLDA_DRIVE_LEGACY_MAX_UPLOAD_MB=30
QLDA_DRIVE_TIMEOUT=90

# Database on Render Persistent Disk
QLDA_DB_PATH=/var/data/qlda_cloud.db
QLDA_RENDER_PERSISTENT_DISK=true

# Optional AI / Google Search
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
